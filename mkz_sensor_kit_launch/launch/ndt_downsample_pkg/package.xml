<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ndt_downsample_pkg</name>
  <version>0.0.1</version>
  <description>
    ROS 2 package that forwards
    /sensing/lidar/concatenated/pointcloud
    → /localization/util/downsample/pointcloud
    with sensor QoS.
  </description>

  <maintainer email="jpatel56@vols.utk.edu">mkz3</maintainer>
  <license>Apache-2.0</license>

  <!-- Runtime deps for your Python node -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Optional test deps (can be left as-is or removed if you want) -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <!-- THIS is what tells colcon to use ament_python and NOT CMake -->
    <build_type>ament_python</build_type>
  </export>
</package>

